# Normalize text files to LF in the repository and working tree.
* text=auto eol=lf

# Windows scripts may require CRLF when executed by cmd.exe.
*.bat text eol=crlf
*.cmd text eol=crlf

# PowerShell scripts are safe with LF and should remain portable.
*.ps1 text eol=lf

# Source and config files.
*.js text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.svg text eol=lf
*.txt text eol=lf

# Lockfiles and package metadata.
package.json text eol=lf
package-lock.json text eol=lf

# Binary files.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.tgz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary