{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "harness:manual-verification-ticket",
  "title": "ManualVerificationTicket",
  "type": "object",
  "required": ["run_id", "generated_at", "items"],
  "properties": {
    "run_id": { "type": "string" },
    "generated_at": { "type": "string" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["verify_item", "precondition", "expected_result", "verifier"],
        "properties": {
          "verify_item": { "type": "string" },
          "precondition": { "type": "string" },
          "expected_result": { "type": "string" },
          "reproduce_steps": { "type": "string" },
          "verifier": { "type": "string" },
          "due_at": { "type": "string" },
          "confirmed": { "type": "boolean" },
          "confirmed_at": { "type": "string" },
          "confirmed_note": { "type": "string" }
        }
      }
    }
  }
}
